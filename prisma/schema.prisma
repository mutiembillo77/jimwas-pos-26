/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model approval_history {
  id                String            @id
  request_id        String
  action            String
  actor_id          String
  actor_name        String
  actor_role        String
  comment           String?
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  users             users             @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approval_requests approval_requests @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([request_id], map: "idx_approval_history_request")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model approval_requests {
  id                                          String                 @id
  request_type                                String
  requester_id                                String
  requester_name                              String
  requester_role                              String
  entity_type                                 String
  entity_id                                   String
  request_data                                Json
  reason                                      String
  status                                      String?                @default("pending")
  approver_id                                 String?
  approver_name                               String?
  approved_at                                 DateTime?              @db.Timestamptz(6)
  rejection_reason                            String?
  branch_id                                   String?
  branch_name                                 String?
  created_at                                  DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime?              @default(now()) @db.Timestamptz(6)
  sync_status                                 String?                @default("pending")
  approval_history                            approval_history[]
  users_approval_requests_approver_idTousers  users?                 @relation("approval_requests_approver_idTousers", fields: [approver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_approval_requests_requester_idTousers users                  @relation("approval_requests_requester_idTousers", fields: [requester_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
