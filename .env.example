# Supabase Configuration (Frontend / Browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# KCB BUNI M-Pesa Express — Server-Side Edge Function Secrets
# Credentials are standardly stored in the database (kcb_settings table) and configured
# via Settings > Payments in the app by authorized administrators.
# The Edge Function can fallback to these server-side environment secrets:
KCB_BUNI_CLIENT_ID=your-kcb-client-id
KCB_BUNI_CLIENT_SECRET=your-kcb-client-secret
KCB_BUNI_BASE_URL=https://api.sandbox.kcb.co.ke
KCB_BUNI_TOKEN_URL=https://api.sandbox.kcb.co.ke/oauth/token
KCB_BUNI_CALLBACK_URL=https://your-project.supabase.co/functions/v1/kcb-ipn-notification

